# ============================================
# Syncore - 环境变量模板
# 复制到 backend/.env 并填入真实值（后端是从 backend/ 目录启动的）
#   cp .env.example .env
# ============================================

# --- LLM 配置 (OpenAI 兼容接口) ---
# 切换模型只需修改这三个变量，业务代码零改动
# 示例: 通义/阿里云百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
#       DeepSeek:         https://api.deepseek.com/v1
#       智谱:             https://open.bigmodel.cn/api/paas/v4
#       OpenAI:           https://api.openai.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-placeholder-key-change-me
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
# 单次请求超时（秒）与重试次数
# ⚠️ 思考型模型（qwen3.x-flash、deepseek-r1 等）首字延迟高，建议放宽到 60~120
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# --- 上下文管理（长对话不爆窗，也不断崖式失忆）---
# 旧实现只给模型最近 20 条消息、工具结果硬切 2000/3000 字。现在是按 token 预算：
# 先折叠旧工具输出，不够再把更早的对话压成结构化摘要（保留用户原话里的
# 路径、命令、数字、约束）。以下都有合理默认值，不填即可。
#
# 模型上下文窗口（tokens）。常见模型有内置估算；未识别的模型按这个值。
# 估小只是多压缩一次，估大是直接 400 —— 不确定时宁小勿大。
#CONTEXT_WINDOW_TOKENS=32768
# 按模型覆盖窗口，JSON 或「模型=tokens,模型=tokens」。匹配规则是子串取最长。
#CONTEXT_WINDOW_OVERRIDES={"qwen-plus":131072,"qwen3.7-flash":262144,"deepseek-chat":131072}
# 给输出预留的 token；触发压缩的比例与压缩后保留的原文比例。
#CONTEXT_OUTPUT_RESERVE_TOKENS=4096
#CONTEXT_COMPACT_RATIO=0.85
#CONTEXT_RECENT_RATIO=0.38
# 为「本轮还会继续长」预留的余量：触发点不晚于「可用窗口 - 它」。
#CONTEXT_HEADROOM_TOKENS=8192
# 摘要模型：留空跟随当前回答模型；必须与当前供应商走同一条连接。
#CONTEXT_SUMMARY_MODEL=
# 摘要调用超时（秒）。超时/失败会退化为确定性摘要，不阻塞当轮回答。
#CONTEXT_SUMMARY_TIMEOUT_SECONDS=60
# 摘要记录与工具输出全文的落盘目录（删会话时同步清理）。
#CONTEXT_SUMMARY_DIR=./data/context_summaries
#TOOL_RESULTS_DIR=./data/tool_results
# 最近几条工具结果保持完整；更早的折叠成占位（观察屏蔽）。
#CONTEXT_KEEP_RECENT_TOOL_RESULTS=6
# 旧工具调用参数（写文件正文等）超过这个字符数就折叠。
#CONTEXT_TOOL_ARGS_MAX_CHARS=2000
# 单条工具结果超过内联上限就落盘，只留头尾并给出读取路径。
#TOOL_RESULT_INLINE_CHARS=12000
#TOOL_RESULT_HEAD_CHARS=8000
#TOOL_RESULT_TAIL_CHARS=2000
# 摘要与工具输出缓存的保留期（天）。
#CONTEXT_SUMMARY_TTL_DAYS=90
#TOOL_RESULT_TTL_DAYS=7

# --- 联网搜索 + 网页抓取（百炼 Responses API 内置 web_search / web_extractor，2026-10-03 起）---
# 默认复用上面 LLM_* 的网关与密钥，以下留空即可；需要独立搜索后端时才填。
# ⚠️ WEB_SEARCH_MODEL 影响延迟档位，预算要跟着它走：
#    qwen3.7-flash 搜索 ~6s / 抓取 ~23s；qwen3.8-max 搜索 15~20s / 抓取 28~60s+。
#WEB_SEARCH_MODEL=
#WEB_SEARCH_BASE_URL=
#WEB_SEARCH_API_KEY=
# 搜索路预算（秒）：flash 档 20 够用；qwen3.8-max 档用默认 40。
#WEB_SEARCH_TIMEOUT_SECONDS=40
# 关思考：实测同一查询开思考 74s / 关思考 6.3s。⚠️ 该参数是 Qwen 系网关扩展，
# 换非 Qwen 后端若报 400，改为 false。
#WEB_SEARCH_DISABLE_THINKING=true
# 「网页抓取」路（query 含网址时自动启用 web_extractor）的预算（秒）。
# ⚠️ 网关硬约束：web_extractor 必须开思考（非思考模式 400，实测），思考方差大，
# flash 档 ~23s、qwen3.8-max 档 28~60s+。
#WEB_FETCH_TIMEOUT_SECONDS=120

# --- Embedding 配置 ---
#
# 两个后端二选一，差别不止「快慢」：
#   api   —— 调 OpenAI 兼容接口。需要网关与密钥，数据出机器，按 token 计费。
#   local —— 进程内跑本地模型。离线可用、数据不出机器、不按量计费；
#            首次加载 2~12 秒（几乎全是首次导入 torch 的代价），
#            启动时后台预热、不占用户时间，之后单条查询约 11ms。
# 入库是全量分块、条数远多于问答，本地后端在这个环节更划算。
#
# ⚠️ 换后端**必须同时改 EMBEDDING_DIMENSION**（维度随模型变），
#    且 Milvus Collection 必须重建（维度建表时定死、事后改不了）：
#      python -c "from app.core.milvus_client import milvus_manager as m; m.delete_collection()"
#    然后重新入库：python scripts/index_samples.py
#    不重建的话向量召回会**恒返回空** —— 不报错，只是检索效果变差。
EMBEDDING_BACKEND=api

# --- EMBEDDING_BACKEND=local 时生效 ---
# 模型目录（推荐，纯离线）或 HuggingFace id。
# 下载（HuggingFace 打不开时用镜像）：
#   HF_ENDPOINT=https://hf-mirror.com huggingface-cli download BAAI/bge-small-zh-v1.5 \
#       --local-dir /path/to/model/bge-small-zh-v1.5
# bge-small-zh-v1.5：512 维、4 层 BERT，中文短文本检索的性价比之选。
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_DEVICE=cpu
# bge-small-zh-v1.5 的 max_position_embeddings 就是 512，调大没有意义
EMBEDDING_LOCAL_MAX_LENGTH=512
EMBEDDING_LOCAL_BATCH_SIZE=32
# 查询侧指令前缀（只作用于查询，**绝不作用于入库段落**）。
# v1.5 官方说明「不加也能检索」，默认留空 —— 留空的好处是两侧同空间，
# 不存在「单侧加前缀导致相似度整体偏移」的风险。
# 若要启用（短查询检索长文档），中文模型填：为这个句子生成表示以用于检索相关文章：
EMBEDDING_LOCAL_QUERY_PREFIX=

# --- EMBEDDING_BACKEND=api 时生效 ---
# 可与 LLM 使用相同或不同的服务商
#
# ⚠️ 维度必须与所选模型实际输出一致，否则入库会报维度错误。
#    部分模型会忽略 dimensions 参数并固定输出维度
#    （例如 qwen3.7-text-embedding-flash 恒为 1024），换模型后请实测确认。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-placeholder-key-change-me
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
# 单批 embedding 请求条数上限。
# ⚠️ 各家网关不一致：本项目实测网关上限为 20，写大了（曾写 100）会在文件块数
#    超过 20 时才突然报 400。代码收到「批大小超限」错误会自动折半重试，
#    此值只是首选的起始批大小。
EMBEDDING_MAX_BATCH=20

# --- Milvus 配置 ---
# 架构：独立容器 my_milvus（milvusdb/milvus:v3.0.1）+ 外置 etcd 容器 milvus-etcd
#       （quay.io/coreos/etcd:v3.5.5），两者同处 docker 网络 milvus-net；
#       不使用 MinIO，向量数据直接落宿主机磁盘（COMMON_STORAGETYPE=local）。
#       详见根目录 docker-compose.yml 与 docs/reference/configuration.md § Milvus。
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base
# 认证凭据。**留空 = 不发送凭据**（服务端未开认证时的正确做法）。
# 开了认证（COMMON_SECURITY_AUTHORIZATIONENABLED=true）就必须填，否则
# 症状是启动日志报「Milvus 未就绪」→ RAG 静默退化为纯 LLM 直答（无来源标注）。
# ⚠️ 只设 COMMON_SECURITY_DEFAULTROOTPASSWORD 而没开 AUTHORIZATIONENABLED 时，
#    Milvus **不会**校验口令（填错也连得上）—— 别把「连上了」当成「认证生效了」。
MILVUS_USER=
MILVUS_PASSWORD=

# --- Redis 配置 ---
# LangGraph Checkpointer 需要 RediSearch + RedisJSON 模块（Redis 8+ 官方镜像已内置）
# 不可用时自动降级为进程内存 Checkpointer
REDIS_URL=redis://localhost:6379/0

# --- Elasticsearch (Phase 3 关键词召回 / BM25) ---
# 本地开发用 single-node + xpack.security=false，因此不需要账号密码。
# 若启用了安全模块，再填 ES_USERNAME / ES_PASSWORD（两者都填才会带 Basic Auth）。
ES_ENABLED=true
ES_URL=http://localhost:9200
ES_INDEX=xjms_knowledge
ES_TIMEOUT_SECONDS=10
# ES_USERNAME=
# ES_PASSWORD=

# --- 混合检索 (Phase 3) ---
# hybrid:       向量召回 + BM25 召回 → RRF 融合 → 精排（默认，推荐）
# hybrid_graph: 在 hybrid 基础上**显式**带上图路（三路，用于评估对照 / 需要多跳时）
# vector:       只走向量检索（等价 Phase 1 行为，用于对照实验）
# bm25:         只走关键词检索（用于验证「项目编号 X-123」这类精确匹配场景）
# graph:        只走图检索（多跳），用于证明「图能到达单跳两路都够不到的地方」
#
# ⚠️ 注意 hybrid 内部也会读 GRAPH_ENABLED：图能用且非空时，hybrid 自动包含图路。
#    hybrid_graph 的价值是**显式**声明意图（不依赖图当前是否可用），评估的
#    阶段对照表就是靠它把「两路」与「三路」拆成两行，否则数字会随环境漂移。
RETRIEVAL_MODE=hybrid
HYBRID_VECTOR_TOP_K=20     # 向量这一路的召回条数（粗排求召回率）
HYBRID_BM25_TOP_K=20       # BM25 这一路的召回条数
HYBRID_RRF_K=60            # RRF 平滑常数，经典取值 60；越小越偏向单路第一名
HYBRID_VECTOR_WEIGHT=1.0   # RRF 中向量路的权重
HYBRID_BM25_WEIGHT=1.0     # RRF 中 BM25 路的权重（同时作用于 ES 查询 boost）

# --- Rerank 精排 (Phase 3) ---
#
# 三个后端二选一，差别不止「快慢」：
#   api   —— 调 DashScope 原生重排接口（qwen3.7-text-rerank）。零下载、开箱可用，
#            但每次精排都是一次网络往返，且按量计费。
#   local —— 进程内跑 BGE Cross-Encoder。离线可用、数据不出机器、不按量计费；
#            代价是模型体积大（bge-reranker-v2-m3 的 fp32 权重 2.27GB）
#            且 CPU 推理比双塔慢一个量级 —— 所以候选数必须截断（见下）。
#   none  —— 不精排，直接输出 RRF 融合结果（做 A/B 对照）
RERANK_ENABLED=true
RERANK_BACKEND=api
RERANK_API_URL=            # 留空则从 LLM_BASE_URL 推导出 DashScope 原生重排路径
RERANK_API_KEY=            # 留空则复用 LLM_API_KEY
RERANK_MODEL=qwen3.7-text-rerank
RERANK_TOP_N=5             # 精排后注入 Prompt 的条数
# 送进精排的融合候选上限（在 RRF 结果之上取前 N 条）。
# ⚠️ 别删这一项：Cross-Encoder 要逐对跑完整前向，而融合结果最多有
#    VECTOR_TOP_K + BM25_TOP_K + GRAPH_TOP_K 条（默认 20+20+20=60）。
#    全送进去的话，local 后端在 CPU 上要跑几十秒，比不精排还慢。
#    业界标准做法是「粗排多召回、精排只重排 Top-20~50」，这里取 20。
#
#    ⚠️ `local` 后端要按机器性能重新定这个值。本机实测（bge-reranker-v2-m3，
#       CPU 8 线程，真实语料块中位 251 token）：**约 0.67 秒/候选** ——
#        5 条 3.5s · 10 条 6.7s · 20 条 13.4s
#       批大小几乎不影响耗时（±10%）；线程数影响很大（12 线程比 8 线程快 ~20%）。
#       CPU-only 部署建议取 `RERANK_TOP_N` 的 2 倍左右（默认即 10），
#       这样既有「把第 6~10 名提上来」的余地，又不会让每轮问答多等十几秒。
RERANK_CANDIDATES=20
RERANK_TIMEOUT_SECONDS=20

# --- RERANK_BACKEND=local 时生效 ---
# 模型目录（推荐，纯离线）或 HuggingFace id。
# 下载（HuggingFace 打不开时用镜像）：
#   HF_ENDPOINT=https://hf-mirror.com huggingface-cli download BAAI/bge-reranker-v2-m3 \
#       --local-dir /path/to/model/bge-reranker-v2-m3
# bge-reranker-v2-m3：568M 参数（XLM-R large 底座）、多语言、8192 上下文。
# 追求速度可换 bge-reranker-base（278M，中文稍弱但快一倍）。
RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
RERANK_LOCAL_DEVICE=cpu
# 每对 (query, 文档) 截断到这个长度。知识库分块本就短，512 足够且快得多。
# ⚠️ 注意它只在上限处起作用：**没超过就不会截断，也就不会变快**
#    （sentence-transformers 是按批内最长序列 padding，不是按 max_length）。
RERANK_LOCAL_MAX_LENGTH=512
# reranker 的输入是拼接后的长序列，内存占用按 batch × 序列长 平方级增长
# （注意力矩阵），所以默认批大小刻意比 embedding 的 32 小。
# 实测批大小对耗时影响很小（4~32 之间 ±10%），不用花时间调它。
RERANK_LOCAL_BATCH_SIZE=8
# torch 推理线程数，0 = 交给 torch 自己决定（本机 16 逻辑核 → torch 取 8）。
# ★ 这是本地精排**唯一有效的性能开关**：本机实测 20 条候选，
#   2 线程 48s → 4 线程 33s → 8 线程 18s → 12 线程 14s（长文本档）。
#   但它会和 FastAPI 线程池、Milvus/ES 抢核，所以默认交给 torch。
RERANK_LOCAL_THREADS=0

# --- GraphRAG 图检索 (Phase 4b) ---
# Neo4j 实体关系图作为**第三路**召回，负责「问题横跨多份文档」的多跳推理。
# 需要先跑 python scripts/build_graph.py（或 POST /api/graph/build）把图建起来；
# **索引与建图是两个独立步骤** —— 只入库不建图，这一路会恒返回空（启动日志会告警）。
#
# ⚠️ 首次启动 Neo4j 约需 80 秒才 ready，抢跑会得到 Couldn't connect to localhost:7687。
#    凭据写在 backend/.env，浏览器控制台 http://localhost:7474
#    概念上手册：docs/architecture.md § 十一 · 配置细则：docs/configuration.md § 11.5
# ⚠️ 下面的口令必须与根目录 docker-compose.yml 的 NEO4J_AUTH 一致，否则重建容器后
#    图路会一直连不上（现象只是「Neo4j 未就绪」，前端照常出答案，很难察觉）。
#    本机实际部署：容器 my_neo4j（neo4j:enterprise），数据 bind 在 B:\Neo4jData。
GRAPH_ENABLED=true
GRAPH_URI=bolt://localhost:7687
GRAPH_USER=neo4j
GRAPH_PASSWORD=xjms-graph-2026
GRAPH_DATABASE=neo4j
GRAPH_TIMEOUT_SECONDS=10
# 多跳展开上限：1 = 只看直接邻居；2 = 「查询实体 → 中间实体 → 答案块」。
# ⚠️ 再往上收益急剧衰减而噪声线性增长，默认 2，不要为了「看起来更强」上调。
GRAPH_MAX_HOPS=2
GRAPH_TOP_K=20             # 图路自己的候选条数（与另外两路同量级，RRF 只看名次）
GRAPH_WEIGHT=1.0           # RRF 中图路的权重。调高会让远端块压过直接相关的块
GRAPH_MIN_ENTITY_CHARS=2   # 参与查询匹配的实体最小长度（单字几乎必然误匹配）
# ★ 多跳证据保底槽 —— 本组最重要的一条
# RRF 按「被几路命中」投票，只被图路召回的块只有一票，必然排在「两路共识」之后。
# 即「纯 RRF 下多跳证据几乎不可能进入最终结果」，图会变成「建了但看不出效果」。
# 此值为「仅被图路召回、且跳数 ≥ 1」的候选保留几个最终名额（追加在末尾）。
# 设 0 可关闭（回到纯 RRF，用于对照实验）。
GRAPH_MIN_MULTIHOP=1
GRAPH_BUILD_CONCURRENCY=4  # 构建时打模型 + 写图的并发上限
GRAPH_BUILD_BATCH_SIZE=200
GRAPH_EXTRACT_MODEL=       # 留空则复用 LLM_MODEL
GRAPH_EXTRACT_TIMEOUT_SECONDS=60
GRAPH_EXTRACT_MAX_CHARS=2000   # 单块送入抽取的字符上限（chunk 本身约 500 字）

# --- MCP 工具接入 ---
# ⚠️ server 清单现在写在 data/mcp/servers.json，由设置页「MCP」维护（增删改、开关、连接测试）。
# 下面的 MCP_SERVERS 只在那份文件**不存在时**被读一次当种子，之后以文件为准 —— 改它不会生效。
# 搬走的原因：JSON 写在 .env 里改一次要重启一次，而且连不上时界面什么也说不清。
MCP_ENABLED=true
MCP_SERVERS=[]
# 清单文件（可能含 token，风险面同 llm_profiles.json：本机明文、出参只给掩码）
MCP_STORE=./data/mcp/servers.json
# 一次工具调用的读超时
MCP_TIMEOUT_SECONDS=30
# 建立连接（握手 + 拉工具清单）的总时限；卡死的 server 不会把「保存」这个请求吊住
MCP_CONNECT_TIMEOUT_SECONDS=60
# 连不上的 server 隔多久才允许自动重试；界面上点「连接测试 / 重连」无视这个窗口，立刻真试
MCP_RETRY_SECONDS=120

# 条目字段（写在文件里同理）:
#   name            小写字母/数字/下划线/连字符；工具名前缀默认取它
#   transport       stdio | streamable_http | sse
#   command/args    stdio 用；command 写 python 会自动换成当前解释器（虚拟环境里的那个）
#   url             streamable_http / sse 用
#   headers         HTTP 头，鉴权 token 放这里（值只写不读，出参永远是 ********）
#   danger_level    safe | moderate | danger —— danger 自动进审批闭环
#   allowed_agents  留空 = 对所有专员开放
# 示例（接入仓库自带的演示 Server：天气 / 汇率 / 货币换算）:
# MCP_SERVERS=[{"name":"demo","transport":"stdio","command":"python","args":["mcp_servers/demo_server.py"],"danger_level":"safe"}]
#
# 暂不支持：OAuth 2.1 授权流（要鉴权请在 headers 里自带 Bearer token）、
# MCP 的 resources / prompts 两种原语（只接 tools）。

# --- 技能 (Skills) ---
# 一个技能 = 一个目录 + 一份 SKILL.md（YAML frontmatter 写 name/description，正文写做法），
# 可选 scripts/ references/ assets/ 放材料。照 Agent Skills 规范实现。
# 渐进式披露：每轮只注入「名字 + 一句话用途」，模型要用时才调 use_skill 取正文，
# 材料文件再按需 read —— 所以装几十个技能也不会把上下文撑爆。
# 用户技能目录（把技能文件夹拷进去即可，设置页有「重新扫描」）
SKILLS_DIR=./data/skills
# 随仓库走的内置技能目录（只读，改动走 git）
SKILLS_BUNDLED_DIR=./skills
# 界面上的启停覆写（只记录被关掉的那几个）
SKILLS_STATE_STORE=./data/skills/state.json
SKILLS_ENABLED=true
# 注入块的字符上限；超出的技能不列出，但块里会明说「还有 N 个没列出」并指向 skills_list
SKILLS_INJECT_MAX_CHARS=3000

# --- FastAPI 配置 ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- 文件上传 ---
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50

# --- 本地 Office / PDF 转换（可选；不配置时从 PATH 探测） ---
# Filee portable 目录中的 filee-cli.exe；需提前部署所需引擎以离线运行
OFFICE_FILEE_PATH=
OFFICE_CONVERT_TIMEOUT_SECONDS=120

# --- Agent 文件工具沙箱 (Phase 2) ---
# file_agent / code_agent 的读写删除、Shell 执行都被限制在该目录内
FILE_SANDBOX_DIR=./data/workspace

# --- Phase 2 Agent 运行时 ---
# 单轮最多工具调用步数（防死循环）
AGENT_MAX_TOOL_STEPS=6
# HITL 审批等待超时（秒），超时视为拒绝
APPROVAL_TIMEOUT_SECONDS=300
# 是否启用 LangGraph 多 Agent 模式；false 则退回 Phase 1 纯 RAG
ENABLE_GRAPH=true

# --- 审批留痕与预授权 (Phase 6) ---
# 审批记录是**证据**：进程崩了、容器重启了，「谁在什么时候批了什么」不能因此消失。
# 采用 **append-only** 事件日志（与长期记忆的「原子整文件写」刻意相反取舍 ——
# 前者是「历史」语义，后者是「当前值」语义），查询时折叠出每会话的当前决策。
# ⚠️ 留痕含**用户原话级内容**，与 .env / data/traces 同级敏感，必须 gitignore
#    （backend/data/approvals/ 已在 .gitignore 中）。
APPROVAL_RECORD_ENABLED=true
APPROVAL_RECORD_PATH=./data/approvals/records.jsonl
APPROVAL_RECORD_MEMORY=500   # 内存里保留多少条供接口查询（更早的历史走文件 grep）
# 保留期（天）：超期记录从 records.jsonl **归档**到 archive/records-YYYY-MM.jsonl
# （而非删除 —— 审批是审计证据，宁可磁盘多点也不能丢）。0 = 永不归档。
# 与 trace 的 30 天不同：审批是低频高价值事件，默认 90 天
APPROVAL_RETENTION_DAYS=90
# 预授权（「这个工具接下来 N 次别再问我」）的硬边界：无上限的预授权等于把 HITL 关掉，
# 而用户不会意识到自己关掉了它。作用域是 (会话, 工具)，下两项是次数与有效期双上限。
APPROVAL_GRANT_TTL_SECONDS=900
APPROVAL_GRANT_MAX_USES=10

# --- 链路追踪 (Phase 4) ---
# 采集每次问答的完整执行链路（意图 / 检索 / 精排 / 工具 / 生成），
# 按天分片落盘为 JSONL，进程重启时回填最近 N 条到内存缓冲。
# 关闭它只会让 /api/traces 恒为空，**不影响主业务链路**。
OBSERVABILITY_ENABLED=true
TRACE_DIR=./data/traces
# 内存中保留的最近链路条数（列表接口从这里取数）
TRACE_MAX_MEMORY=500
# 启动时回填的历史条数；0 表示不回填（只显示本次进程产生的链路）
TRACE_LOAD_ON_START=100
# 保留期（天）：启动时删除早于该天数的日分片；0 = 永不清理（默认）
# 磁盘上的 trace 是排查证据，删除只走这条本地策略，没有 HTTP 删除接口（刻意）
TRACE_RETENTION_DAYS=30

# --- 语音 (Phase 4b) ---
# STT（语音输入）+ TTS（语音播报）。语音是入口/出口增强，不在 Agent 主链路：
# 挂了只是按钮不可用，问答照常。
# STT 双后端：local（本机 SenseVoice，离线、默认）/ dashscope（云端 qwen3-asr-flash）。
# 云端走 DashScope 原生接口，
# ⚠️ 不用 OpenAI 兼容层 —— 它的 ASR 只收公网音频 URL、不吃 base64（实测 400）。
VOICE_ENABLED=true
VOICE_STT_BACKEND=local
# 本地模型目录（留空 = 本地模型根目录下的 sherpa-onnx-sense-voice-…
# 根目录的约定同 LOCAL_MODEL_DIR；推断不出时退回 %LOCALAPPDATA%/xjms/models）
VOICE_STT_LOCAL_MODEL=
VOICE_STT_MODEL=qwen3-asr-flash
# 桌面助手唤醒词（本地 sherpa-onnx KWS）模型目录；留空 = 模型根目录下的
# sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01
VOICE_WAKE_MODEL=
VOICE_STT_TIMEOUT_SECONDS=60
VOICE_MAX_AUDIO_MB=10
# TTS 双后端：dashscope（qwen3-tts-flash，效果好，默认）/ edge（免费兜底）
VOICE_TTS_BACKEND=dashscope
VOICE_TTS_MODEL=qwen3-tts-flash
VOICE_TTS_VOICE=Cherry
VOICE_TTS_VOICE_EDGE=zh-CN-XiaoxiaoNeural
VOICE_TTS_RATE=+0%
VOICE_TTS_FORMAT=mp3
VOICE_TTS_TIMEOUT_SECONDS=60

# --- LangFuse 旁路导出 (Phase 4，可选) ---
# 走官方 ingestion REST API，**不引入 langfuse SDK**（那会拖进 opentelemetry 全家桶）。
# 导出失败只记账、不影响本地落盘 —— 本地 JSONL 才是评估数据的唯一来源。
# ⚠️ LangFuse 已把该端点标记为 deprecated，自建实例若开了 v4 events_only 模式，
#    trace-create 事件会被过滤；本项目为此让每条 span 都自带完整 traceId 冗余。
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TIMEOUT_SECONDS=10

# --- 评估体系 (Phase 4) ---
# 跑批请用 CLI，不进 HTTP 接口（34×N 次真实模型调用，秒级超时伺候不了）:
#   python scripts/run_eval.py                 # 六阶段对照（含仅图阶段）+ 归因
#   python scripts/run_eval.py --assert-baseline   # 断言设计保证成立的性质（8 项）
#   python scripts/run_eval.py --attribution-k 1   # 收紧口径以暴露排序层问题
EVAL_GOLDEN_SET=./data/eval/golden_set.json
EVAL_REPORT_DIR=./data/eval/reports
# builtin: 用项目自己的 LLM 网关做判定（零新增依赖，默认）
# ragas:   Ragas 官方口径 —— 可选 extra，会降级 langchain-openai / openai 版本，
#          与当前锁定的依赖不兼容（已验证会打挂基线），非必要不要开
EVAL_JUDGE_BACKEND=builtin
EVAL_JUDGE_MODEL=         # 留空则复用 LLM_MODEL
EVAL_JUDGE_TIMEOUT_SECONDS=60
EVAL_JUDGE_CONCURRENCY=4  # 生成与判定都打真实模型，用信号量限流而非无上限并发

# --- 增量索引 (Phase 5) ---
# 用「内容指纹清单」找出变更，只重建变了的那部分。
# 为什么不是文件监听事件：监听会丢事件（后端没在跑时丢进去的文件永远等不到通知）、
# 跨平台 API 不同、编辑器保存常是「写临时文件 + 改名覆盖」会触发事件风暴。
# 扫描 + 指纹天然幂等、能追赶任何遗漏、零新依赖。
#
# ⚠️ 后台监听默认**关**：它会主动产生成本（目录一变就调 Embedding）。
#    关着也能用：
#      POST /api/index/scan?dry_run=true   只出变更计划，秒级、可随意重试
#      POST /api/index/scan                立即执行（会调 Embedding）
#      python scripts/watch_knowledge.py --once   适合 cron / CI
INDEX_WATCH_ENABLED=false
# 要扫描的目录，逗号分隔；相对路径锚定 backend/（不随 CWD 漂移）
INDEX_WATCH_DIRS=./samples/knowledge
# 扫描间隔（秒）。实际会被夹到 >= 5 秒
INDEX_WATCH_INTERVAL_SECONDS=60
# 指纹清单路径。⚠️ **不要**把它放在 INDEX_WATCH_DIRS 里面：
#   清单本身是 .json（在入库白名单内），会形成「重写清单 → 清单变了 →
#   当已修改文档 → 重新向量化 → 又重写清单」的死循环，不报错、只烧钱。
#   代码里已做显式排除（见 rag/incremental.py::_excluded_paths），但别去依赖它。
INDEX_MANIFEST=./data/index_manifest.json
# 单轮最多处理多少文件，超出部分跳过并在报告里给出数量（防手滑把整个盘扫进来）
INDEX_WATCH_MAX_FILES=2000

# --- 长期记忆 (Phase 5) ---
# 跨会话记住用户的**稳定偏好**（输出格式 / 语言 / 语气 / 详略 / 工具习惯），
# 在构造子 Agent 的 System Prompt 时注入。
#
# 与 Redis Checkpointer 的分工：Redis 是**短期记忆**（这一段对话，绑 thread_id），
# 本模块是**长期记忆**（跨会话成立的偏好，绑用户）。两者不重叠、不互相替代。
#
# 存储用单文件 JSON 而不是 Redis：Redis 在本项目里是可降级依赖（重启可能丢），
# 而「长期」记忆恰恰最不能丢。放文件里换来重启不丢 + 可 git diff + 坏掉时
# 最差只是「Agent 不认识你」。
MEMORY_ENABLED=true
MEMORY_STORE=./data/memory/profile.json
MEMORY_USER_ID=default
# 注入上限（条数 + 字符数）。记忆会随时间增长，不设上限的话某一天
# 它会悄悄挤掉真正有用的检索上下文。超出部分按置信度从低到高丢弃。
MEMORY_MAX_ITEMS=50
MEMORY_INJECT_MAX_CHARS=1200

# 遗忘曲线 + 回弹：S 为半衰期（天），R=2^(-距上次强化的天数/S)。
# 旧文件按原更新时间起算，不会在首次读取时把全部记忆重新激活。
# 姓名、生日、纪念日和手动置顶条目保留；普通作息/喜好会逐渐淡化。
MEMORY_DECAY_ENABLED=true
MEMORY_INITIAL_STABILITY_DAYS=30
MEMORY_FOCUS_STABILITY_DAYS=3
MEMORY_MAX_STABILITY_DAYS=3650
MEMORY_RECALL_THRESHOLD=0.2
MEMORY_REBOUND_GAIN=1.5
MEMORY_REINFORCE_INTERVAL_HOURS=6
# MEMORY_DECAY_ENABLED=false 时回退原 TTL 规则；0 关闭对应过期过滤。
MEMORY_TTL_DAYS=365
MEMORY_FOCUS_TTL_DAYS=30
# 被动抽取：fire-and-forget 后台任务，从对话里推断偏好（用户没说「记住」也能学）。
# 它**不会推迟 SSE 流关闭** —— 答案先完整给用户，学到的东西下一次提问才生效。
MEMORY_EXTRACT_ENABLED=true
MEMORY_EXTRACT_TIMEOUT_SECONDS=30
MEMORY_EXTRACT_MODEL=    # 留空则复用 LLM_MODEL（抽取是短任务，用小模型更划算）

# 工作空间协作：每次运行的统一预算与消息投递护栏
WORKSPACE_MAX_LLM_CALLS=80
WORKSPACE_MAX_TOKENS=160000
WORKSPACE_MAX_SECONDS=3600
WORKSPACE_MAX_RETRIES=6
WORKSPACE_DELIVERY_MAX_ATTEMPTS=3
WORKSPACE_DELIVERY_TIMEOUT_SECONDS=1800
